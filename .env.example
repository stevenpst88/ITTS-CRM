# ════════════════════════════════════════
#  ITTS CRM 環境變數範本
#  部署到 Vercel 時請在 Project Settings → Environment Variables 設定
# ════════════════════════════════════════

# ── 執行環境 ──
NODE_ENV=production

# ── Session / JWT 簽章金鑰（64 字元 hex，自行產生）──
# 產生指令: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_64_char_hex_secret_here
JWT_SECRET=your_64_char_hex_secret_here

# ── 異質系統整合機敏資料加密金鑰（選填，32 bytes = 64 字 hex）──
# 用來加密 SAP 等外部系統的連線密碼 / client secret（AES-256-GCM）。
# 不設定時：自動由 JWT_SECRET 派生金鑰（可運作，但 JWT_SECRET 輪替後舊密文需重新輸入）。
# 正式環境建議設獨立金鑰。產生指令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SAP_ENCRYPTION_KEY=

# ── 資料庫後端切換 ──
# 'json'     → 本地 data.json（開發用）
# 'postgres' → Supabase Postgres（正式用）
DB_BACKEND=postgres

# ── Supabase 設定 ──
# Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Supabase Postgres 直連字串
# Dashboard → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# ── 檔案儲存後端切換 ──
# 'local'    → ./uploads/（開發用）
# 'supabase' → Supabase Storage（正式用）
STORAGE_BACKEND=supabase
SUPABASE_BUCKET=uploads

# ── CORS 允許來源（部署後改成自己的域名）──
CORS_ORIGIN=https://your-app.vercel.app

# ── Web Push 推播（PWA notification）──────────────
# 產生指令：
#   node -e "const k=require('web-push').generateVAPIDKeys(); console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\nVAPID_PRIVATE_KEY='+k.privateKey)"
# Public key 會送到瀏覽器，Private key 只能放伺服器端。
# Subject 必須是 mailto: 或 https:// URL，給瀏覽器供應商聯絡用
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@itts.com.tw

# ── 寫入競爭防護（預設全部關閉＝與先前行為完全相同；說明與上線步驟見 DEPLOY.md「寫入競爭防護」）──
# 兩個開關互相獨立，建議先開 QUOTE_NO_ATOMIC、觀察後再開 DB_WRITE_SERIALIZE。
# 注意：Vercel 環境變數的改動只對「新部署」生效，改完要 Redeploy（或 Instant Rollback 回舊部署）。
#QUOTE_NO_ATOMIC=1             # 報價單號改由資料庫原子計數器發放（僅 Postgres；JSON 後端忽略）
#DB_WRITE_SERIALIZE=1          # 寫入型請求以全域寫入鎖序列化（會把連線池 max 由 2 調成 3，請確認 Supabase 連線數上限足夠）
#DB_WRITE_LOCK_WAIT_MS=8000    # 等鎖上限（毫秒）；逾時回 503 DB_BUSY
#DB_WRITE_LOCK_HOLD_MS=20000   # 單一請求持鎖上限（毫秒，最高 22000）；到期強制釋放並記 error
#DB_WRITE_LOCK_EXEMPT=         # 追加「不拿鎖」的路徑（逗號分隔、小寫）。不以 / 結尾＝該路徑及其所有子路徑；以 / 結尾＝只比對其底下的路徑（不含該路徑本身）。見 DEPLOY.md
#DB_WRITE_LOCK_EXTRA_PATHS=    # 追加「會寫入資料的 GET」路徑（逗號分隔、小寫、精確比對）
#DB_QUERY_TIMEOUT_MS=15000     # 僅 DB_WRITE_SERIALIZE=1：連線池的用戶端查詢逾時（毫秒）
