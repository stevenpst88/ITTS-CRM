# ════════════════════════════════════════
#  ITTS CRM 環境變數範本
#  部署到 Vercel 時請在 Project Settings → Environment Variables 設定
# ════════════════════════════════════════

# ── 執行環境 ──
NODE_ENV=production

# ── Session / JWT 簽章金鑰（64 字元 hex，自行產生）──
# 產生指令: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_64_char_hex_secret_here
JWT_SECRET=your_64_char_hex_secret_here

# ── 異質系統整合機敏資料加密金鑰（選填，32 bytes = 64 字 hex）──
# 用來加密 SAP 等外部系統的連線密碼 / client secret（AES-256-GCM）。
# 不設定時：自動由 JWT_SECRET 派生金鑰（可運作，但 JWT_SECRET 輪替後舊密文需重新輸入）。
# 正式環境建議設獨立金鑰。產生指令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SAP_ENCRYPTION_KEY=

# ── 資料庫後端切換 ──
# 'json'     → 本地 data.json（開發用）
# 'postgres' → Supabase Postgres（正式用）
DB_BACKEND=postgres

# ── Supabase 設定 ──
# Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Supabase Postgres 直連字串
# Dashboard → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# ── 檔案儲存後端切換 ──
# 'local'    → ./uploads/（開發用）
# 'supabase' → Supabase Storage（正式用）
STORAGE_BACKEND=supabase
SUPABASE_BUCKET=uploads

# ── CORS 允許來源（部署後改成自己的域名）──
# 允許的瀏覽器來源（逗號分隔）。沒設時預設只有 http://localhost:3000；上線時取消註解並改成正式網域。
# （舊範本寫的 CORS_ORIGIN 程式從未讀取，實際變數是 ALLOWED_ORIGINS。）
#ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Web Push 推播（PWA notification）──────────────
# 產生指令：
#   node -e "const k=require('web-push').generateVAPIDKeys(); console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\nVAPID_PRIVATE_KEY='+k.privateKey)"
# Public key 會送到瀏覽器，Private key 只能放伺服器端。
# Subject 必須是 mailto: 或 https:// URL，給瀏覽器供應商聯絡用
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@itts.com.tw

# ════════════════════════════════════════════════════════════════
#  進階開關（皆為選填；不設定＝預設值＝關閉或安全行為）
#  下面的值只是「預設/範例」，請勿把真實密鑰寫進此範本（真實值只放 Vercel 環境變數或本機 .env）。
#  scripts/check-env-docs.js 會比對程式實際讀取的環境變數與本檔，缺漏會列出。
# ════════════════════════════════════════════════════════════════

# ── 連線 / session ──
# 本機啟動埠（預設 3000；Vercel 不需要）
#PORT=3000
# session 後端：預設 jwt（Vercel 與本機皆同）；設 memory 才用舊的 express-session（僅本機除錯）
#SESSION_BACKEND=jwt
# 閒置登出毫秒數，只給測試縮短用（下限 5000；預設 30 分鐘 = 1800000）。正式環境請勿設
#SESSION_IDLE_MS=

# ── 稽核（內控稽核補強；預設全關，舊路徑行為不變）──
# 稽核事件新表（append-only）。預設關（舊路徑）；設 1 才啟用，且啟用前需先建好 audit_events 表
#AUDIT_EVENTS_TABLE=0
# 稽核鏈（HMAC 雜湊鏈，防竄改）。預設關；設 1 且有可用金鑰才上鏈。僅在 AUDIT_EVENTS_TABLE=1 時有意義
#AUDIT_CHAIN=0
# 稽核鏈專用金鑰（至少 32 字元）。沒設時退而用 JWT_SECRET／SESSION_SECRET；正式環境建議獨立設定
#AUDIT_CHAIN_SECRET=
# 稽核鏈金鑰代號（輪替金鑰用，預設 k1）
#AUDIT_CHAIN_KID=k1
# 舊金鑰對照 JSON，例如 {"k1":"<舊 secret>"}；僅供驗證舊的列，輪替後舊金鑰要留著
#AUDIT_CHAIN_SECRETS_JSON=
# 每日稽核鏈錨點自動推送的外部網址（只接受 https:443，會擋內網位址）。預設不推送
#AUDIT_ANCHOR_WEBHOOK_URL=
# 稽核表建立／改結構時等待資料庫鎖的毫秒數（預設 5000，下限 500）
#AUDIT_DDL_LOCK_TIMEOUT_MS=5000

# ── 登入防護 / 後端功能權限 ──
# 帳號鎖定：設 1 才啟用（預設關）。啟用前至少保留 2 位管理員帳號
#LOGIN_LOCKOUT=0
#LOGIN_MAX_FAILS=5
#LOGIN_FAIL_WINDOW_MINUTES=15
#LOGIN_LOCK_MINUTES=15
#LOGIN_LOCK_MAX_MINUTES=240
# 登入鎖定鍵範圍：ip（預設，帳號＋來源 IP）｜name（舊行為，只看帳號名稱）
#LOGIN_LOCK_SCOPE=ip
# 登入憑證綁密碼版本：預設開（改密碼後舊憑證失效）；off｜0｜false｜no 關閉
#SESSION_PWD_BINDING=on
# 閒置登出分鐘數（>0 才採用；未設＝30 分鐘，由 middleware/jwtSession.js 讀取）
#SESSION_IDLE_MINUTES=30
# 後端功能權限驗證：off｜log（預設，只記錄不擋）｜enforce（回 403）
#FEATURE_GUARD_MODE=log

# ── CSP（內容安全政策）──
# Report-Only 政策＋違規回報端點：on（預設）｜off（完全不加標頭、不註冊端點）
#CSP_REPORT_ONLY=on
# 另加 report-to／Reporting-Endpoints：off（預設）｜on
#CSP_REPORT_TO=off
# 另加只管 style-src 的 Report-Only（會產生大量回報，只在盤點樣式時短暫開）：off（預設）｜on
#CSP_REPORT_ONLY_STYLE=off
# 本實例每小時最多寫入稽核幾筆（預設：新表 120、舊路徑 24）
#CSP_REPORT_MAX_WRITES_PER_HOUR=
# 回報端點限流（預設：整個實例每分鐘 600、每 IP 每分鐘 120）
#CSP_REPORT_GLOBAL_PER_MIN=
#CSP_REPORT_IP_PER_MIN=

# ── 企業主檔責任業務／待補名片待辦 ──
# off＝整個關閉（責任業務欄位、待辦 API、登入彈窗、通知、匯入指定全部停用；既有資料保留）。預設開；沒有責任業務資料時本來就不會觸發任何待辦
#COMPANY_CARD_TASKS=on

# ── 統編查無→申請行銷建檔 ──
# off＝整個關閉（相關端點回 404、名片存檔與報價單送簽／SAP 推送都不檢查建檔狀態；既有申請資料保留）。預設開
#COMPANY_REQUESTS=on

# ── 簽核 / 報價 ──
# 簽核流程引擎：off（預設，舊路徑）｜shadow（舊路徑為準，引擎旁路比對）｜on（引擎為準，例外退回舊路徑）
#QUOTE_FLOW_ENGINE=off
# 簽核流程設計器：只有 1 才開啟（預設 0）
#QUOTE_FLOW_DESIGNER=0
# 簽核設定變更「兩人覆核」：1 或 true 才啟用（預設關）
#APPROVAL_CONFIG_DUAL_REVIEW=0
# 防拆單提醒：off（預設）｜log｜warn。有設定時以環境變數為準，沒設才採後台設定
#QUOTE_SPLIT_GUARD=off
# 報價文件發出：未核准是否允許發出。預設允許；設 0 則未核准的發出回 409 NOT_APPROVED
#QUOTE_ALLOW_UNAPPROVED_ISSUE=1
# 報價草稿浮水印（PDF 斜向浮水印、Excel 草稿註記）：1 才啟用（預設關）
#QUOTE_DRAFT_WATERMARK=0
# 蓋章憑證簽章金鑰。沒設時由 JWT_SECRET／SESSION_SECRET 以獨立網域標籤派生
#QUOTE_ISSUE_SECRET=
# 蓋章憑證是否允許走網址 ?stampToken=：預設拒絕（只收 X-Stamp-Token 標頭）；allow 暫時接受（過渡用）
#STAMP_TOKEN_QUERY=
# 發出紀錄重用視窗（秒；預設 60，0＝關閉重用）
#QUOTE_ISSUE_REUSE_SEC=60
# 每人每分鐘最多新增幾筆發出紀錄（預設 20，0＝不限）
#QUOTE_ISSUE_RATE_PER_MIN=20
# 報價簽核設定 GET /api/quote-approval/config：預設需有報價相關角色；設 1 還原成只驗登入（舊行為）
#QUOTE_CONFIG_OPEN=0
# 簽核流程引擎模式紀錄：Vercel 非 production 部署預設不寫；設 1 還原舊行為（都寫）
#QUOTE_FLOW_MODE_AUDIT_NON_PROD=0
# 引擎模式紀錄的同行程節流毫秒數（預設 600000＝10 分鐘；0＝不節流，測試用）
#QUOTE_FLOW_MODE_THROTTLE_MS=600000
# 同一提案人同一種類的「待覆核」簽核設定申請上限（預設 3，0＝不限）
#APPROVAL_CONFIG_MAX_PENDING=3
# 商機「反覆延後」警示門檻（預設：累計延後次數 2、累計延後天數 30、目前階段停留天數 45）
#PIPELINE_REPEAT_MIN_COUNT=2
#PIPELINE_REPEAT_MIN_DAYS=30
#PIPELINE_REPEAT_STALL_DAYS=45

# ── 信件派送（Exchange／Microsoft Graph；預設 off＝完全不寄信）──
# off（預設）｜log（只寫預覽檔）｜redirect（全部改寄 MAIL_REDIRECT_TO）｜live（真的寄）
#MAIL_MODE=off
# redirect 模式的唯一收件人（單一合法 Email）
#MAIL_REDIRECT_TO=
# 寄件顯示名稱（預設「ITTS-CRM 簽核通知」）
#MAIL_FROM_NAME=
# 信件內連結用的網站根網址（https；預設 https://itts-crm.vercel.app，Vercel 上會自動取 VERCEL_PROJECT_PRODUCTION_URL）
#APP_BASE_URL=
# 收件人網域白名單（逗號分隔；預設 itts.com.tw）
#MAIL_ALLOWED_DOMAINS=itts.com.tw
# Microsoft Graph sendMail 設定（四者皆合法才算已設定；密鑰只放 Vercel 環境變數）
#MAIL_GRAPH_TENANT_ID=
#MAIL_GRAPH_CLIENT_ID=
#MAIL_GRAPH_CLIENT_SECRET=
#MAIL_GRAPH_SENDER=
# 本機信件預覽目錄／outbox 檔名（Vercel 上忽略）
#MAIL_PREVIEW_DIR=.mail-preview
#MAIL_OUTBOX_FILE=mail-outbox.json
# 信件 Cron 端點的授權密鑰（Authorization: Bearer）。沒設＝端點一律拒絕
#CRON_SECRET=

# ── AI ──
# Gemini API 金鑰（AI 功能用；沒設則 AI 功能不可用）
GEMINI_API_KEY=

# ── 由平台自動提供（不要手動設）──
# NODE_ENV 見上方；VERCEL、VERCEL_ENV、VERCEL_URL、VERCEL_REGION、VERCEL_PROJECT_PRODUCTION_URL 由 Vercel 注入
# 版本資訊頁的提交編號用 VERCEL_GIT_COMMIT_SHA、VERCEL_GIT_COMMIT_REF、VERCEL_GIT_COMMIT_MESSAGE、VERCEL_GIT_REPO_OWNER、VERCEL_GIT_REPO_SLUG，同為 Vercel 部署時自動提供，不用設定
